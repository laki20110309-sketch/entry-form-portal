[Unit]
Description=Entry Atelier Discord notification bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=entryatelier
WorkingDirectory=/opt/entry-atelier/discord-bot
EnvironmentFile=/etc/entry-atelier/bot.env
ExecStart=/usr/bin/node /opt/entry-atelier/discord-bot/src/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/entry-atelier/discord-bot/data

[Install]
WantedBy=multi-user.target
